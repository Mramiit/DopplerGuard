<?xml version="1.0" ?>
<!--
  Gazebo Quadcopter Model: 4-Rotor Surveillance Intruder Drone.
  Configured for FMCW Radar Cross Section (RCS ~0.01 m²) and micro-Doppler rotor dynamics.
-->
<sdf version="1.6">
  <model name="intruder_quadcopter">
    <pose>0 0 0.2 0 0 0</pose>
    <static>false</static>

    <!-- Main Chassis Frame -->
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.015</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.015</iyy>
          <iyz>0</iyz>
          <izz>0.025</izz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.30 0.30 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.30 0.30 0.08</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Rotor 1 (Front Right) -->
    <link name="rotor_0">
      <pose>0.15 -0.15 0.06 0 0 0</pose>
      <visual name="rotor_0_visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 0.6</ambient>
          <diffuse>0.9 0.1 0.1 0.6</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rotor 2 (Front Left) -->
    <link name="rotor_1">
      <pose>0.15 0.15 0.06 0 0 0</pose>
      <visual name="rotor_1_visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 0.6</ambient>
          <diffuse>0.9 0.1 0.1 0.6</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rotor 3 (Rear Left) -->
    <link name="rotor_2">
      <pose>-0.15 0.15 0.06 0 0 0</pose>
      <visual name="rotor_2_visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.8 0.6</ambient>
          <diffuse>0.2 0.2 0.9 0.6</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rotor 4 (Rear Right) -->
    <link name="rotor_3">
      <pose>-0.15 -0.15 0.06 0 0 0</pose>
      <visual name="rotor_3_visual">
        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.8 0.6</ambient>
          <diffuse>0.2 0.2 0.9 0.6</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
  </model>
</sdf>
